msgid "Send"
msgstr "Envoyer"

msgid "Thank you! Your message has been sent."
msgstr "Merci ! Votre message a bien été envoyé."

msgid "Missing required \"id\" attribute (PF-E1001)."
msgstr "Attribut « id » manquant (PF-E1001)."

msgid "No usable fields (PF-E1001)."
msgstr "Aucun champ exploitable (PF-E1001)."

msgid "Leave this field empty"
msgstr "Laissez ce champ vide"

msgid "Sorry, your message could not be sent. Please try again."
msgstr "Désolé, votre message n'a pas pu être envoyé. Veuillez réessayer."

msgid "A required field is missing."
msgstr "Un champ obligatoire est manquant."

msgid "The email address looks invalid."
msgstr "L'adresse e-mail semble invalide."

msgid "The phone number looks invalid."
msgstr "Le numéro de téléphone semble invalide."

msgid "A field is too long. Please shorten it."
msgstr "Un champ est trop long. Raccourcissez-le."

msgid "The form was submitted too quickly. Please try again."
msgstr "Le formulaire a été envoyé trop vite. Veuillez réessayer."

msgid "The form has expired. Please reload the page and try again."
msgstr "Le formulaire a expiré. Rechargez la page et réessayez."

msgid "Too many attempts. Please try again later."
msgstr "Vous avez envoyé plusieurs messages en peu de temps. Réessayez plus tard ou contactez-nous autrement si c'est urgent."

msgid "The anti-spam check is missing. Please reload the page."
msgstr "La vérification anti-spam est absente. Rechargez la page."

msgid "The anti-spam check failed. Please try again."
msgstr "La vérification anti-spam a échoué. Veuillez réessayer."

msgid "[%1$s] New lead on %2$s"
msgstr "[%1$s] Nouveau lead sur %2$s"

msgid "Lead #%d — stored in WordPress (Leads menu)."
msgstr "Lead n°%d — enregistré dans WordPress (menu Leads)."

msgid "Leads"
msgstr "Leads"

msgid "Petit Form settings"
msgstr "Réglages Petit Form"

msgid "Settings"
msgstr "Réglages"

msgid "Access denied."
msgstr "Accès refusé."

msgid "Export CSV"
msgstr "Exporter en CSV"

msgid "All forms"
msgstr "Tous les formulaires"

msgid "Filter"
msgstr "Filtrer"

msgid "%d leads"
msgstr "%d leads"

msgid "Date (site timezone)"
msgstr "Date (fuseau horaire du site)"

msgid "Form"
msgstr "Formulaire"

msgid "Data"
msgstr "Données"

msgid "No leads yet."
msgstr "Aucun lead pour le moment."

msgid "Delete this lead permanently?"
msgstr "Supprimer ce lead définitivement ?"

msgid "Delete"
msgstr "Supprimer"

msgid "Invalid nonce (PF-E2001)."
msgstr "Nonce invalide (PF-E2001)."

msgid "Notification email"
msgstr "E-mail de notification"

msgid "Leads are always stored in the database; this email is only a notification."
msgstr "Les leads sont toujours enregistrés en base ; cet e-mail n'est qu'une notification."

msgid "Webhook URL"
msgstr "URL du webhook"

msgid "Optional. Every new lead is POSTed there as JSON."
msgstr "Optionnel. Chaque nouveau lead y est envoyé en JSON (POST)."

msgid "Webhook auth header"
msgstr "En-tête d'authentification du webhook"

msgid "Cloudflare Turnstile"
msgstr "Cloudflare Turnstile"

msgid "Site key"
msgstr "Clé de site"

msgid "Secret key"
msgstr "Clé secrète"

msgid "Optional second anti-spam layer. Leave empty to stay on honeypot + time-trap + rate limiting."
msgstr "Seconde couche anti-spam optionnelle. Laissez vide pour rester sur honeypot + temps minimum + limitation de débit."

msgid "Rate limiting"
msgstr "Limitation de débit"

msgid "locally valid attempts per"
msgstr "tentatives localement valides par"

msgid "seconds, per IP and per form."
msgstr "secondes, par IP et par formulaire."

msgid "Minimum fill time"
msgstr "Temps minimum de remplissage"

msgid "seconds. Faster submissions are rejected as bots."
msgstr "secondes. Les envois plus rapides sont rejetés comme des bots."

msgid "Data on uninstall"
msgstr "Données à la désinstallation"

msgid "Delete the leads table and all settings when the plugin is uninstalled."
msgstr "Supprimer la table des leads et tous les réglages à la désinstallation du plugin."

msgid "Lead deleted."
msgstr "Lead supprimé."

msgid "Lead not found (already deleted?)."
msgstr "Lead introuvable (déjà supprimé ?)."

msgid "Notification delivery stopped after three attempts. Check the PHP error log."
msgstr "Envoi des notifications arrêté après trois tentatives. Consultez le journal d’erreurs PHP."

msgid "Notifications pending. Check WP-Cron if delivery is delayed."
msgstr "Notifications en attente. Vérifiez WP-Cron si l’envoi tarde."

msgid "Petit Form could not write to its leads table. Check database permissions and the PHP error log (PF-E3001/PF-E3002)."
msgstr "Petit Form n’a pas pu enregistrer les leads. Vérifiez les droits de la base de données et le journal d’erreurs PHP (PF-E3001/PF-E3002)."

msgid "Notifications use WP-Cron. Ask your host to run WordPress cron every minute to avoid relying on visits. If DISABLE_WP_CRON is enabled, an external scheduler is required."
msgstr "Les notifications utilisent WP-Cron. Demandez à votre hébergeur d’exécuter les tâches planifiées WordPress chaque minute pour ne pas dépendre des visites. Si DISABLE_WP_CRON est activé, un planificateur externe est nécessaire."

msgid "Petit Form notification task is missing (PF-E4003). Saved leads remain available."
msgstr "La tâche d’envoi des notifications Petit Form est absente (PF-E4003). Les leads enregistrés restent disponibles."

msgid "Petit Form notification task is more than 15 minutes late (PF-E4003). Saved leads remain available; notifications may be delayed."
msgstr "La tâche d’envoi des notifications Petit Form a plus de 15 minutes de retard (PF-E4003). Les leads enregistrés restent disponibles ; les notifications peuvent être retardées."

msgid "Ask your host to check WP-Cron and run WordPress cron every minute. If DISABLE_WP_CRON is enabled, an external scheduler is required."
msgstr "Demandez à votre hébergeur de vérifier WP-Cron et d’exécuter les tâches planifiées WordPress chaque minute. Si DISABLE_WP_CRON est activé, un planificateur externe est nécessaire."
